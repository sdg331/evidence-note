# Optional. Required only when the request uses "useModel": true.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local generation. Ollama must already be running on 127.0.0.1:11434
# with this model installed. No model is pulled by the app.
# ANSWER_PROVIDER=ollama
# OLLAMA_MODEL=exaone3.5:2.4b

# Optional experiment: use local bge-m3 to search only when keyword search
# finds nothing. Leave off for the reliable default and public demos.
# SEMANTIC_RETRIEVAL=1

# Optional. Defaults to backend/data/documents.sqlite3.
# DOCUMENT_QA_DB_PATH=

# Set to 1 for a read-only public demo. Existing documents stay searchable;
# uploading, deleting, and paid model answers are disabled.
# PUBLIC_DEMO=1
